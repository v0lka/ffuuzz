# =============================================================================
# FFUUZZ Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# Priority (highest to lowest):
#   1. CLI flags
#   2. Environment variables (set in shell)
#   3. .env file variables
#   4. Built-in defaults
#
# Variable expansion syntax is supported:
#   FFUUZZ_DATABASE_URI=postgres://${DB_USER}:${DB_PASS}@localhost:5432/ffuuzz
#   or
#   FFUUZZ_DATABASE_URI=postgres://$DB_USER:$DB_PASS@localhost:5432/ffuuzz
#
# Boolean values: "true", "false", "1", "0", "t", "f" (case-insensitive).
# Duration values: Go duration strings like "30s", "5m", "1h".
# =============================================================================

# ---------------------------------------------------------------------------
# Server Addresses
# ---------------------------------------------------------------------------

# API server listen address (host:port).
# The management UI and REST API are served on this port.
# Default: ":8081"
#FFUUZZ_API_ADDRESS=:8081

# MITM proxy listen address (host:port).
# Point your browser or client at this address to intercept traffic.
# Default: ":8080"
#FFUUZZ_PROXY_ADDRESS=:8080

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection URI.
# Format: postgres://user:password@host:port/dbname?params
# Must be a valid PostgreSQL connection string.
# Default: postgres://ffuuzz:ffuuzz@localhost:5432/ffuuzz?sslmode=disable
#FFUUZZ_DATABASE_URI=postgres://ffuuzz:ffuuzz@localhost:5432/ffuuzz?sslmode=disable

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Directory where campaign artifacts (payloads, diffs, screenshots) are stored.
# Created automatically at startup if it does not exist.
# Default: ./artifacts
#FFUUZZ_ARTIFACT_DIR=./artifacts

# ---------------------------------------------------------------------------
# Performance
# ---------------------------------------------------------------------------

# Number of concurrent fuzzing workers.
# Each worker handles one endpoint at a time. Increase for more parallelism
# on multi-core machines. Must be > 0.
# Default: 8
#FFUUZZ_WORKERS=8

# Maximum requests per second across all workers.
# Rate-limiting is applied globally, not per worker. Must be > 0.
# Default: 50
#FFUUZZ_RPS=50

# Timeout for individual HTTP requests to the target server.
# Format: Go duration string (e.g. "3s", "500ms", "1m").
# Default: 3s
#FFUUZZ_REQ_TIMEOUT=3s

# Graceful shutdown timeout.
# Maximum time to wait for in-flight requests to complete during shutdown.
# Format: Go duration string (e.g. "30s", "1m").
# Default: 30s
#FFUUZZ_SHUTDOWN_TIMEOUT=30s

# Maximum HTTP response body size (in bytes) to record and store.
# Bodies larger than this limit are truncated. Must be > 0.
# Default: 65536 (64 KiB)
#FFUUZZ_MAX_BODY_BYTES=65536

# ---------------------------------------------------------------------------
# TLS Settings (applies to upstream connections from the proxy)
# ---------------------------------------------------------------------------

# Skip TLS certificate verification for upstream HTTPS connections.
# Useful for testing against self-signed or internal certificates.
# In production, you may want to set this to false.
# Default: true
#FFUUZZ_TLS_SKIP_VERIFY=true

# Minimum TLS version for upstream connections.
# Allowed values: "1.2" or "1.3".
# Default: 1.2
#FFUUZZ_TLS_MIN_VERSION=1.2

# TLS handshake timeout for upstream connections.
# Format: Go duration string (e.g. "10s", "30s").
# Default: 10s
#FFUUZZ_TLS_HANDSHAKE_TIMEOUT=10s

# Disable TLS session tickets (RFC 5077).
# Disabling improves forward secrecy at the cost of slightly slower reconnections.
# Default: false
#FFUUZZ_TLS_DISABLE_SESSION_TICKETS=false

# ---------------------------------------------------------------------------
# Certificate Cache (MITM proxy dynamically generates TLS certificates)
# ---------------------------------------------------------------------------

# Maximum number of generated certificates kept in the in-memory LRU cache.
# Must be > 0.
# Default: 1000
#FFUUZZ_CERT_CACHE_MAX_ENTRIES=1000

# Directory where generated TLS certificates are persisted on disk.
# Set to an empty string (or omit) to disable disk persistence.
# Default: certs
#FFUUZZ_CERT_CACHE_DIR=certs

# Keep generated certificates in memory only (do not write to disk).
# Useful for ephemeral environments or when disk I/O is a concern.
# Default: false
#FFUUZZ_CERT_MEMORY_ONLY=false

# ---------------------------------------------------------------------------
# LLM-Assisted Triage (AI-powered finding classification)
# ---------------------------------------------------------------------------

# Enable AI-assisted triage of findings.
# Requires a valid API key and provider configuration (see below).
# Default: false
#FFUUZZ_LLM_ENABLED=false

# LLM provider to use.
# Currently supported: "anthropic" (Anthropic Claude) or "openai" (OpenAI GPT).
# Required when FFUUZZ_LLM_ENABLED=true.
# Default: (none)
#FFUUZZ_LLM_PROVIDER=anthropic

# API key for the chosen LLM provider.
# For Anthropic: create a key at https://console.anthropic.com/
# For OpenAI: create a key at https://platform.openai.com/api-keys
# Default: (none)
#FFUUZZ_LLM_API_KEY=sk-ant-...

# Optional: Custom base URL for the LLM API endpoint.
# Use this for API-compatible proxies, local models (e.g. Ollama),
# or self-hosted endpoints. Leave empty for the provider's default.
# Default: (none — uses provider default)
#FFUUZZ_LLM_BASE_URL=

# Model name to use.
# Examples: "claude-sonnet-4-20250514", "gpt-4o", "gpt-4o-mini".
# Leave empty to use the provider's default model.
# Default: (none — uses provider default)
#FFUUZZ_LLM_MODEL=

# Maximum tokens in the LLM response.
# Higher values allow more detailed analysis but increase latency and cost.
# Must be > 0.
# Default: 4096
#FFUUZZ_LLM_MAX_TOKENS=4096

# Timeout for each LLM API call.
# Format: Go duration string (e.g. "30s", "1m").
# Default: 30s
#FFUUZZ_LLM_TIMEOUT=30s
